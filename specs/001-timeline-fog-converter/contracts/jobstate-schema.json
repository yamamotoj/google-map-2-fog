{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JobState",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cursor", "budget", "outputs"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nextDateToProcess"],
      "properties": {
        "nextDateToProcess": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "lastRunAt": { "type": "string" }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxRouteRequestsPerDay", "routeRequestsUsedToday", "lastBudgetResetDate"],
      "properties": {
        "maxRouteRequestsPerDay": { "type": "integer", "minimum": 0 },
        "routeRequestsUsedToday": { "type": "integer", "minimum": 0 },
        "lastBudgetResetDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exportedDates"],
      "properties": {
        "exportedDates": {
          "type": "array",
          "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    },
    "routeCacheIndex": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keys": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}


